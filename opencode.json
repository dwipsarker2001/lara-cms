{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [
        "superpowers@git+https://github.com/obra/superpowers.git",
        "@dietrichgebert/ponytail"
    ],
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "firecrawl": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "firecrawl-mcp"
            ],
            "env": {
                "FIRECRAWL_API_KEY": "fc-7af8eb68efd242d0b12e8cdd5fc07f0a"
            }
        }
    }
}